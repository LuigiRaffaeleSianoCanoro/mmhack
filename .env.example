# Set these in Vercel project env vars. Never commit real values.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Optional illustration (AWS-60). Defaults: medium JPEG, 45s server deadline, 42s per attempt, 1 retry on 5xx/timeout if time remains.
FIXIT_IMAGE_QUALITY=medium
FIXIT_IMAGE_DEADLINE_MS=45000
FIXIT_IMAGE_ATTEMPT_MS=42000
# Base44 Landlord Inbox (AWS-59). Server-only; never NEXT_PUBLIC_. Without these, delivery is export-only (stored locally).
BASE44_APP_ID=
BASE44_APP_URL=
# One of: an API key (sent as the api_key header), a user token, or a dedicated inbox-bot user login
BASE44_API_KEY=
BASE44_TOKEN=
BASE44_BOT_EMAIL=
BASE44_BOT_PASSWORD=
INBOX_STORE_FILE=
